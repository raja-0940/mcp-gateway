export E2E_SCHEME="https"
export E2E_HTTPS_REAL_CERTS="true"
export E2E_PLATFORM="openshift"
export E2E_TIMEOUT="120m"
export E2E_PROCS="4"

export MCP_GATEWAY_NAMESPACE="mcp-system"
export GATEWAY_NAMESPACE="gateway-system"
export GATEWAY_CLASS_NAME="openshift-default"

export GATEWAY_CA_BUNDLE_SECRET="trusted-ca-bundle"
export GATEWAY_CA_BUNDLE_CONFIGMAP="trusted-ca-bundle"
export GATEWAY_TLS_SECRET="router-certs-default"

export E2E_DOMAIN="apps.$(oc get dns cluster -o jsonpath='{.spec.baseDomain}')"
export MCP_GATEWAY_HOST="mcp.${E2E_DOMAIN}"
export GATEWAY_URL="${E2E_SCHEME}://${MCP_GATEWAY_HOST}/mcp"
export GATEWAY_TLS_LISTENER_HOSTNAME="*.${E2E_DOMAIN}"

export POWER_TEST_REGISTRY="quay.io/raja0940"
export POWER_TEST_TAG="ppc64le-$(git -C /root/rhcl/mcp-gateway rev-parse --short HEAD)"
