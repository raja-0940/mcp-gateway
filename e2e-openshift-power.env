export E2E_PLATFORM="openshift"
export E2E_SCHEME="https"
export E2E_HTTPS_REAL_CERTS="true"
export E2E_TIMEOUT="120m"

export MCP_GATEWAY_NAMESPACE="mcp-system"
export GATEWAY_NAMESPACE="gateway-system"
export TEST_SERVER_NAMESPACE="mcp-test"

export E2E_DOMAIN="apps.$(oc get dns cluster -o jsonpath='{.spec.baseDomain}')"

export GATEWAY_PUBLIC_HOST="mcp.${E2E_DOMAIN}"

export ELICITATION_PUBLIC_HOST="elicitation.${E2E_DOMAIN}"
export URL_ELICITATION_PUBLIC_HOST="url-elicitation.${E2E_DOMAIN}"

export PROTOCOL_2026_PUBLIC_HOST="mcp.protocol-2026.${E2E_DOMAIN}"
export RESOURCES_FEDERATION_PUBLIC_HOST="mcp.resources-federation.${E2E_DOMAIN}"

export A2A_PASSTHROUGH_PUBLIC_HOST="mcp.a2a-passthrough.${E2E_DOMAIN}"

export GATEWAY_URL="https://${GATEWAY_PUBLIC_HOST}/mcp"

export ELICITATION_GATEWAY_URL="https://${ELICITATION_PUBLIC_HOST}/mcp"
export URL_ELICITATION_GATEWAY_URL="https://${URL_ELICITATION_PUBLIC_HOST}/mcp"

export PROTOCOL_2026_GATEWAY_URL="https://${PROTOCOL_2026_PUBLIC_HOST}/mcp"
export RESOURCES_FEDERATION_GATEWAY_URL="https://${RESOURCES_FEDERATION_PUBLIC_HOST}/mcp"

export A2A_PASSTHROUGH_GATEWAY_URL="http://${A2A_PASSTHROUGH_PUBLIC_HOST}/mcp"

export AUTH_GATEWAY_URL="${GATEWAY_URL}"

export GATEWAY_TLS_LISTENER_HOSTNAME="$(printf '\052').${E2E_DOMAIN}"
export GATEWAY_CA_BUNDLE_SECRET="trusted-ca-bundle"

export GATEWAY_CLASS_NAME="istio"
export E2E_PROCS="1"
export GATEWAY_TLS_SECRET="router-certs-default"
export GATEWAY_CA_BUNDLE_CONFIGMAP="mcp-gateway-e2e-ca-bundle"

export E2E1_PUBLIC_HOST="e2e-1.${E2E_DOMAIN}"
export TEAM_A_PUBLIC_HOST="team-a.${E2E_DOMAIN}"
export TEAM_B_PUBLIC_HOST="team-b.${E2E_DOMAIN}"

export E2E1_GATEWAY_URL="https://${E2E1_PUBLIC_HOST}/mcp"
export TEAM_A_GATEWAY_URL="https://${TEAM_A_PUBLIC_HOST}/mcp"
export TEAM_B_GATEWAY_URL="https://${TEAM_B_PUBLIC_HOST}/mcp"

export TOOL_DISCOVERY_PUBLIC_HOST="mcp.tool-discovery.${E2E_DOMAIN}"
export TOOL_DISCOVERY_GATEWAY_URL="http://${TOOL_DISCOVERY_PUBLIC_HOST}/mcp"
